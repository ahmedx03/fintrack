# ═══════════════════════════════════════════════════════════════
#  fintrack_frontend/.env.example
#
#  Copy this file to .env and fill in your values.
#  The .env file is listed in .gitignore — never commit it.
#
#  cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# The full URL of your Django backend (no trailing slash).
#
# Dev:  leave empty — Vite's proxy handles /api → localhost:8000
#   VITE_API_URL=
#
# Prod: set to your Render URL
#   VITE_API_URL=https://fintrack-api.onrender.com
VITE_API_URL=
